{
  "name": "openleaf",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first Overleaf-like LaTeX editor",
  "license": "MIT",
  "author": "OpenLeaf contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/neoyinzhanghan/OpenLeaf.git"
  },
  "bugs": {
    "url": "https://github.com/neoyinzhanghan/OpenLeaf/issues"
  },
  "homepage": "https://github.com/neoyinzhanghan/OpenLeaf#readme",
  "workspaces": [
    "server",
    "client",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "openleaf": "node cli/bin/openleaf.js",
    "postinstall": "node scripts/install-cli-bin.mjs",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client && npm run typecheck -w cli",
    "test": "node scripts/test-all.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "^22.13.0 || ^23.4.0 || >=24.0.0"
  }
}
